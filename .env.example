PORT=4000
NODE_ENV=development

# Konfigurasi Database (Ganti user, password, host, port, dan dbname sesuai lingkungan lokal/Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Konfigurasi JSON Web Token (Ganti dengan string rahasia yang panjang)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Konfigurasi TMDB API (Dapatkan API Key v3 dari The Movie Database)
TMDB_API_KEY=your_tmdb_api_key_v3_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500